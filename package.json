{
  "name": "concord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebMCP tells an agent what a site can do. Nothing tells it what a site can take back. Concord is that missing layer, and the first agent that cannot overpromise.",
  "scripts": {
    "dev": "node server.mjs",
    "probe": "node tools/probe.mjs",
    "probe:01": "URL=http://localhost:5173/ node tools/probe.mjs",
    "probe:02": "URL=http://localhost:5173/phase02.html node tools/probe.mjs",
    "probe:03": "URL=http://localhost:5173/phase03.html node tools/probe.mjs",
    "probe:04": "URL=http://localhost:5173/phase04.html node tools/probe.mjs",
    "concord": "URL=http://localhost:5173/concord.html node tools/shot.mjs",
    "probe:concord": "URL=http://localhost:5173/concord-test.html node tools/probe.mjs",
    "test": "node --test concord/agent-surface.test.mjs kit/canonical.test.mjs concord/ladder.test.mjs concord/saga.test.mjs concord/receipt.test.mjs concord/recover.test.mjs concord/journal.test.mjs",
    "verify": "node tools/verify-receipt.mjs",
    "export": "node tools/export-receipt.mjs",
    "conformance": "URL=http://localhost:5173/conformance.html node tools/probe.mjs",
    "publish:verify": "cd verify && npm publish --access public",
    "check": "bash tools/check.sh"
  },
  "license": "MIT"
}
